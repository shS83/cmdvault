@dataclass
class Entry:
	command: str
	count: int = 0
	recent: int = -1
	favorite: bool = False
	priority: int | None = None
	hosts: tuple = ()
	secrets: tuple = field(init=False)

	def __post_init__(self):
		self.secrets = secret_reasons(self.command)


def history_commands(text):
	"""Timestamped Bash entries preserve literal multiline commands."""
	pending = None
	for line in text.splitlines():
		if re.fullmatch(r"#[0-9]+", line):
			if pending is not None:
				command = "\n".join(pending)
				if command.strip():
					yield command
			pending = []
		elif pending is not None:
			pending.append(line)
		elif line.strip():
			yield line
	if pending is not None:
		command = "\n".join(pending)
		if command.strip():
			yield command


def favorites_path():
	root = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share")
	return root / "cmdvault/favorites.json"


def priority_path():
	return favorites_path().with_name("favorites.priority.json")


def read_priorities():
	path = priority_path()
	try:
		data = json.loads(path.read_text(encoding="utf-8"))
	except FileNotFoundError:
		return []
	if not isinstance(data, list) or any(not isinstance(x, str) for x in data):
		raise ValueError("Invalid priority favorites file")
	return list(dict.fromkeys(data))


def write_priorities(items):
	# Atomic replacement; keep a separate ordering file, preserving favorites.json.
	path = priority_path()
	path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
	fd, temporary = tempfile.mkstemp(prefix=".priority-", dir=path.parent)
	try:
		with os.fdopen(fd, "w", encoding="utf-8") as output:
			json.dump(items, output, ensure_ascii=False, indent=2)
			output.write("\n")
			output.flush()
			os.fsync(output.fileno())
		os.chmod(temporary, 0o600)
		os.replace(temporary, path)
	finally:
		if os.path.exists(temporary):
			os.unlink(temporary)
	_sync_priority_metadata(items)


def _sync_priority_metadata(items):
	"""Stage priority changes only for records already approved for Cloud Sync."""
	from src.database import transaction
	from src.sync.store import LocalStore
	from src.security.secrets import CommandSecretScanner
	root = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share")
	db = root / "cmdvault/favorites.sync.sqlite3"
	if not db.is_file():
		return
	order = {command: index for index, command in enumerate(items)}
	with LocalStore(db) as store, transaction(store.connection):
		for record in store.records("command"):
			if record.sync_state.value != "sync_eligible":
				continue
			data = dict(record.data)
			command = data.get("command")
			if command in order:
				data["priority"] = order[command]
				data["favorite"] = True
			else:
				data.pop("priority", None)
			if data != record.data:
				result = CommandSecretScanner().scan(data)
				if not result.allowed:
					raise ValueError("Priority metadata failed local secret check")
				store._put("command", record_natural_key(command), data)


def record_natural_key(command):
	from src.sync.store import natural_key
	return natural_key("command", command)


def stage_current_approved_metadata():
	"""Queue favorite/priority changes for previously reviewed records only."""
	from src.sync.approved_metadata import stage_approved_metadata
	root = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share")
	return stage_approved_metadata(root / "cmdvault/favorites.sync.sqlite3",
		read_favorites(favorites_path()), read_priorities())


def toggle_priority_favorite(command):
	"""Promote to priority, or demote to an ordinary favorite."""
	priorities = read_priorities()
	if command in priorities:
		write_priorities([x for x in priorities if x != command])
		stage_current_approved_metadata()
		return False
	# Persist favorite before publishing the priority marker.
	if command not in read_favorites(favorites_path()):
		update_favorite(favorites_path(), command)
	write_priorities([command, *(x for x in priorities if x != command)])
	stage_current_approved_metadata()
	return True


def toggle_favorite(command):
	"""Add an ordinary favorite; remove existing favorite and priority together."""
	path = favorites_path()
	if command in read_favorites(path):
		update_favorite(path, command, remove=True)
		priorities = read_priorities()
		if command in priorities:
			write_priorities([x for x in priorities if x != command])
		stage_current_approved_metadata()
		return False
	update_favorite(path, command)
	stage_current_approved_metadata()
	return True


def reorder_priority(command, direction):
	priorities = read_priorities()
	if command not in priorities:
		return False
	i = priorities.index(command)
	j = i + direction
	if not 0 <= j < len(priorities):
		return False
	priorities[i], priorities[j] = priorities[j], priorities[i]
	write_priorities(priorities)
	stage_current_approved_metadata()
	return True


def read_favorites(path):
	return FavoritesBridge(path).read()


def update_favorite(path, command, remove=False):
	FavoritesBridge(path).update(command,remove=remove)


def history_without(text, command):
	"""Remove exact logical entries, preserving untouched bytes and timestamps."""
	blocks = []
	pending = None
	for line in text.splitlines(keepends=True):
		if re.fullmatch(r"#[0-9]+", line.rstrip("\r\n")):
			if pending is not None:
				blocks.append(pending)
			pending = [line]
		elif pending is not None:
			pending.append(line)
		else:
			blocks.append([line])
	if pending is not None:
		blocks.append(pending)
	kept = []
	removed = 0
	for block in blocks:
		body = block[1:] if re.fullmatch(r"#[0-9]+", block[0].rstrip("\r\n")) else block
		value = "\n".join(line.rstrip("\r\n") for line in body)
		if value == command:
			removed += 1
		else:
			kept.extend(block)
	return "".join(kept), removed


def delete_history_command(path, command):
	"""Delete all exact matches without creating a backup containing the secret."""
	import fcntl
	path = path.expanduser().resolve()
	if not path.exists():
		return 0
	with open(str(path) + ".cmdvault.lock", "a", encoding="utf-8") as lock:
		fcntl.flock(lock, fcntl.LOCK_EX)
		original = path.read_bytes()
		cleaned, removed = history_without(original.decode("utf-8"), command)
		if not removed:
			return 0
		fd, temporary = tempfile.mkstemp(prefix=".cmdvault-history-", dir=path.parent)
		try:
			with os.fdopen(fd, "wb") as output:
				output.write(cleaned.encode("utf-8"))
				output.flush()
				os.fsync(output.fileno())
			if path.read_bytes() != original:
				raise ValueError("History changed during deletion; retry.")
			os.replace(temporary, path)
		finally:
			if os.path.exists(temporary):
				os.unlink(temporary)
	return removed


def delete_entry(path, command):
	# Preflight favorites so malformed data is never silently discarded.
	favorite_file = favorites_path()
	read_favorites(favorite_file)
	count = delete_history_command(path, command)
	FavoritesBridge(favorite_file).update(command,remove=True,delete_record=True)
	return count


def entries_from(history, favorites):
	entries = {}
	in_private_key = False
	for index, command in enumerate(history_commands(history)):
		if "\0" in command:
			continue
		entry = entries.setdefault(command, Entry(command))
		# Untimestamped history represents a pasted PEM block as separate rows.
		# Carry the warning only across contiguous key body/footer lines.
		stripped = command.strip()
		if in_private_key:
			if re.fullmatch(r'[A-Za-z0-9+/=]{16,}', stripped) or re.fullmatch(
					r'-----END (?:OPENSSH |RSA |EC |DSA |ENCRYPTED )?PRIVATE KEY-----', stripped):
				entry.secrets = tuple(dict.fromkeys((*entry.secrets, 'private key fragment')))
			else:
				in_private_key = False
		if PRIVATE_KEY.fullmatch(stripped):
			in_private_key = True
		elif stripped.startswith('-----END '):
			in_private_key = False
		entry.count += 1
		entry.recent = index
	for command in favorites:
		entries.setdefault(command, Entry(command)).favorite = True
	priority_index = {command: n for n, command in enumerate(read_priorities())}
	for command, entry in entries.items():
		if entry.favorite and command in priority_index:
			entry.priority = priority_index[command]
	return sorted(entries.values(), key=lambda e: (
		0 if e.priority is not None else 1 if e.favorite else 2,
		e.priority if e.priority is not None else 0,
		-e.recent,
	))


def display(command):
	# Escape control characters in the picker without changing the saved command.
	return json.dumps(command, ensure_ascii=False)[1:-1]


def entries_from_current(entries):
	indices = {value: index for index, value in enumerate(read_priorities())}
	for entry in entries:
		entry.priority = indices.get(entry.command) if entry.favorite else None
	return sorted(entries, key=lambda e: (0 if e.priority is not None else 1 if e.favorite else 2,
											e.priority if e.priority is not None else 0, -e.recent))


SORT_MODES = ("default", "a-z", "z-a", "most used", "least used")


def sorted_entries(entries, mode):
	if mode == "a-z":
		return sorted(entries, key=lambda e: (e.command.casefold(), e.command))
	if mode == "z-a":
		return sorted(entries, key=lambda e: (e.command.casefold(), e.command), reverse=True)
	if mode == "most used":
		return sorted(entries, key=lambda e: (-e.count, e.command.casefold(), e.command))
	if mode == "least used":
		return sorted(entries, key=lambda e: (e.count, e.command.casefold(), e.command))
	return list(entries)


HOST_COLORS = {
    "ALPHATAURI": (0, 229, 255),   # electric cyan
    "EPSILONTAURI": (255, 79, 216), # synthwave pink
    "THETATAURI": (184, 255, 77),  # laser lime
    "OUROBOROS": (179, 136, 255),   # lavender
}


def colored_hosts(hosts):
    """Color only host labels, not the executable command or warning status."""
    if not hosts:
        return ""
    labels = []
    for host in hosts:
        host = str(host).upper()
        rgb = HOST_COLORS.get(host, (255, 194, 102))
        label = "\x1b[38;2;%d;%d;%dm%s\x1b[0m" % (*rgb, host)
        labels.append(label)
    return "[" + ", ".join(labels) + "] "


def entry_row(index, entry):
    color = '\x1b[31m' if entry.secrets else '\x1b[32m' if entry.priority is not None else '\x1b[33m' if entry.favorite else ''
    warning = '[POSSIBLE SECRET: ' + ', '.join(entry.secrets) + '] ' if entry.secrets else ''
    symbol = '◆' if entry.priority is not None else '★' if entry.favorite else '·'
    return (f'{index}\t{color}{warning}{symbol}  {entry.count:>4}x  '
            + display(entry.command)
            + ('\x1b[0m' if color else '') + '\n')


def confirm_delete(command, terminal="/dev/tty"):
	"""Ask on the terminal, never consume piped input or emit executable output."""
	with open(terminal, 'w', encoding='utf-8') as output, open(terminal, 'r', encoding='utf-8') as source:
		output.write(f'Deleting {display(command)}, are you sure? y/n [n]: ')
		output.flush()
		return source.readline().strip().lower() == 'y'


def pick(entries, query, favorites_only, enter_action="run", history_path=None):
	with tempfile.TemporaryDirectory(prefix='cmdvault-picker-') as folder:
		return pick_loop(entries, query, favorites_only, enter_action, history_path,
						 Path(folder) / 'position')


def _cv_selection_indices(rows, entries):
	"""Resolve fzf output by stable row index; do not parse displayed commands."""
	selected = []
	for row in rows:
		try:
			index = int(row.split("\t", 1)[0])
		except (ValueError, IndexError) as error:
			raise ValueError("Invalid picker selection") from error
		if not 0 <= index < len(entries):
			raise ValueError("Invalid picker selection")
		if index not in selected:
			selected.append(index)
	return selected


def _cv_confirm_batch_delete(count, terminal="/dev/tty"):
	"""Single acknowledgement for a destructive, possibly multi-command edit."""
	with open(terminal, "w", encoding="utf-8") as output, open(terminal, "r", encoding="utf-8") as source:
		output.write(f"Delete {count} selected command(s) from Bash history and favorites? y/N: ")
		output.flush()
		return source.readline().strip().lower() == "y"


def _cv_sync_worker(db_path, history_path, status_file):
    """Network work only; never touches fzf or the controlling terminal."""
    try:
        from src.sync.interactive import sync_now
        from src.sync.store import LocalStore
        db_path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        with LocalStore(db_path):
            pass
        result = sync_now(db_path,
            history_path=history_path or Path(os.environ.get("HISTFILE") or Path.home() / ".bash_history"),
            favorites_path=favorites_path(), priority_path=priority_path(),
            get_phrase=lambda prompt: (_ for _ in ()).throw(ValueError(
                "Configure CMD_SYNC_KEY or CMDVAULT_SYNC_KEY_FILE before Ctrl-R; interactive key entry would hide the UI")))
        imported = result.get("imported") or {}
        text = (f"Cloud Sync: staged {imported.get('newly_approved', 0)}, "
                f"excluded {imported.get('excluded', 0)}, pushed {result['pushed']}, "
                f"received {result['received']}, pending {result['pending']}.")
        _cv_write_sync_status(status_file, "synced", text)
    except Exception as exc:
        from src.sync.client import SyncHTTPError
        state = "offline" if isinstance(exc, SyncHTTPError) and exc.code == "offline" else "error"
        _cv_write_sync_status(status_file, state, "Cloud Sync: error: " + str(exc))


def _cv_write_sync_status(path, state, message=""):
    """Atomic progress indicator shared with the terminal renderer."""
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps({"state": state, "message": message}), encoding="utf-8")
    os.replace(tmp, path)


def pick_loop(entries, query, favorites_only, enter_action, history_path, position_path):
	local_entries = entries
	global_entries = None
	fzf = shutil.which("fzf")
	if not fzf:
		raise ValueError("fzf is required for the picker. Install it or use --list.")
	env = os.environ.copy()
	env.pop("FZF_DEFAULT_OPTS", None)
	env.pop("FZF_DEFAULT_OPTS_FILE", None)
	env['CMDVAULT_POSITION_FILE'] = str(position_path)
	position = 1
	caps = detect(sys.stderr)
	backend, fallback_notice = select(_VISUAL_CONFIG.renderer, caps, raster_layout=True)
	if backend in ("kitty", "sixel"):
		try:
			import PIL
		except ImportError:
			backend = "ansi"
			fallback_notice = "Raster graphics needs Pillow: uv sync --extra graphics; using ANSI."
	if fallback_notice:
		print("cmdvault: " + fallback_notice, file=sys.stderr)
	neon_picker = backend == "kitty" and sys.stdin.isatty()
	if neon_picker:
		dimensions = shutil.get_terminal_size((80, 24))
		neon_picker = dimensions.columns >= 32 and dimensions.lines >= 10
	terminal_picker = sys.stdin.isatty() and backend in ("ansi", "kitty", "sixel")
	def invoke(argv, **kwargs):
		if terminal_picker:
			removed = ("--height=", "--border=", "--border-label=") if neon_picker or backend == "sixel" else ("--height=",)
			argv = [arg for arg in argv if not arg.startswith(removed)]
			argv += ["--no-clear", "--height=100%", ("--margin=1,2,0,2" if backend == "sixel" else "--margin=1,0,0,0")]
			if neon_picker or backend == "sixel":
				argv += ["--border=none"]
			return run_picker(argv, input=kwargs["input"], env=kwargs["env"], config=_VISUAL_CONFIG, graphics=neon_picker, sixel=backend == "sixel")
		return subprocess.run(argv, **kwargs)
	notice = ""
	_sync_thread = None
	_sync_status_file = position_path.parent / "cmdvault-sync-ui-status.json"
	try:
		_sync_status_file.unlink(missing_ok=True)
	except OSError:
		pass
	env["CMDVAULT_SYNC_STATUS_FILE"] = str(_sync_status_file)
	_cv_write_sync_status(_sync_status_file, "ready")
	view = "favorites" if favorites_only else "local"
	sort_mode = 0
	while True:
		if _sync_thread is not None and not _sync_thread.is_alive():
			_sync_thread.join()
			_sync_thread = None
			try:
				state = json.loads(_sync_status_file.read_text(encoding="utf-8"))
				notice = "\n" + state.get("message", "")
			except (OSError, ValueError):
				pass
			global_entries = None
		if view in ("global", "global favorites"):
			if global_entries is None:
				root = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share")
				remote = remote_metadata(root / "cmdvault/favorites.sync.sqlite3")
				current_host = socket.gethostname().split('.')[0].upper()
				by_command = {e.command: replace(e, hosts=(current_host,)) for e in local_entries}
				for command, metadata in remote.items():
					entry = by_command.setdefault(command, Entry(command))
					entry.favorite |= metadata["favorite"]
					if entry.priority is None and metadata["priority"] is not None:
						entry.priority = metadata["priority"]
					entry.hosts = tuple(sorted(set(entry.hosts) | set(metadata['hosts'])))
					# Locally repeated commands overlap with that host's synced count.
					# Avoid double counting when its approved record is present.
					entry.count = max(entry.count, metadata["count"])
				global_entries = sorted(by_command.values(), key=lambda e: (0 if e.priority is not None else 1 if e.favorite else 2, e.priority if e.priority is not None else 0, -e.recent))
			entries = global_entries
		else:
			entries = local_entries
		displayed_entries = sorted_entries(entries, SORT_MODES[sort_mode])
		rows = ''.join(entry_row(index, entry) for index, entry in enumerate(displayed_entries)
			if view not in ("favorites", "global favorites") or entry.favorite or entry.priority is not None)
		warnings = sum(bool(entry.secrets) for entry in entries)
		# Errors too long for the bottom status area open a readable dialog.
		# Keep the short status string, never truncate the actual message.
		message = notice.strip()
		modal = message.lower().startswith(("error", "cloud sync: error", "save failed", "deletion failed"))
		env.pop("CMDVAULT_ERROR_MODAL", None)
		if modal and terminal_picker:
			env["CMDVAULT_ERROR_MODAL"] = message
		visible_notice = ("\nError — see dialog (ESC to close)." if modal and terminal_picker else notice)
		# Full command preview is intentionally separate from the one-line fzf row.
		# Only the stable numeric row ID is handed to the preview renderer.
		preview_file = position_path.parent / "commands-preview.json"
		preview_file.write_text(json.dumps([{"command": item.command, "hosts": list(item.hosts) if view in ("global", "global favorites") else []} for item in displayed_entries], ensure_ascii=False), encoding="utf-8")
		preview_cmd = ("python3 " + shlex.quote(str(Path(__file__).resolve().parent / "src/visuals/command_preview.py"))
			+ " " + shlex.quote(str(preview_file)) + " {1}")
		result = invoke(
			[fzf, *fzf_options(backend in ("kitty", "sixel") or caps.truecolor, _VISUAL_CONFIG.glow), "--ansi", "--no-sort", "--delimiter=\t", "--with-nth=2..", "--multi", "--bind=ctrl-space:toggle-down", "--layout=reverse",
			 "--preview=" + preview_cmd, "--preview-window=right:60%:wrap:hidden",
			 "--bind=right:show-preview,left:hide-preview,ctrl-o:toggle-preview,alt-right:preview-page-down,alt-left:preview-page-up,pgup:preview-page-up,pgdn:preview-page-down",
			 "--padding=0,2,0,2", "--height=90%", "--border=rounded", "--prompt=vault › ", "--print-query",
			 "--border-label= CMDVAULT / " + view.upper() + " / " + SORT_MODES[sort_mode].upper() + " ",
			 "--header=→ PREVIEW · ← CLOSE · CTRL-O TOGGLE PREVIEW · S SORT · CTRL-G GLOBAL · SHIFT-ALT-F GLOBAL FAVORITES · CTRL-F FAVORITES · CTRL-L LOCAL · CTRL-P PRIORITY · CTRL-R SYNC" +
			 f"\n{warnings} possible secret(s): red rows. Review and use CTRL-D to remove." + visible_notice,
			 "--sync", "--with-shell=bash -c",
			 "--bind=result:last+pos(" + str(position) + ")+unbind(result)",
			 '--bind=focus:execute-silent(printf "%s" "$FZF_POS" > "$CMDVAULT_POSITION_FILE")',
			 "--expect=s,alt-F,ctrl-s,alt-f,ctrl-y,ctrl-d,ctrl-g,ctrl-f,ctrl-l,ctrl-p,alt-up,alt-down,ctrl-r", "--query=" + query],
			input=rows, capture_output=True, text=True, env=env,
		)
		if result.returncode in (1, 130):
			return None
		if result.returncode:
			raise ValueError("fzf failed: " + result.stderr.strip())
		lines = result.stdout.splitlines()

		valid_keys = {
			"",
			"ctrl-s", "alt-f", "ctrl-y", "ctrl-d",
			"ctrl-g", "alt-F", "ctrl-f", "ctrl-l", "ctrl-p",
			"alt-up", "alt-down", "ctrl-r", "s",
		}

		if len(lines) < 2 or lines[1] not in valid_keys:
			raise ValueError("Invalid picker output.")

		query, key = lines[:2]
		selected_rows = lines[2:]
		if key == "s":
			sort_mode = (sort_mode + 1) % len(SORT_MODES)
			position = 1
			continue

		if key == "ctrl-r":
			if _sync_thread is not None and _sync_thread.is_alive():
				notice = "\nCloud Sync already running."
			else:
				try:
					# Do not block fzf with an interactive getpass prompt.
					if not (os.environ.get("CMDVAULT_SYNC_KEY_FILE") or os.environ.get("CMD_SYNC_KEY")):
						raise ValueError("Set CMD_SYNC_KEY (or CMDVAULT_SYNC_KEY_FILE) before Ctrl-R")
					stage_current_approved_metadata()
					root = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share")
					db_path = root / "cmdvault/favorites.sync.sqlite3"
					_cv_write_sync_status(_sync_status_file, "syncing", "Cloud Sync in progress")
					_sync_thread = threading.Thread(target=_cv_sync_worker,
						args=(db_path, history_path, _sync_status_file), daemon=True)
					_sync_thread.start()
					notice = "\nCloud Sync running in background…"
				except Exception as error:
					notice = "\nCloud Sync: error: " + display(str(error))
					_cv_write_sync_status(_sync_status_file, "error", notice)
			position = 1
			continue
		# Näkymää voi vaihtaa ilman valittua komentoa.
		if key in ("ctrl-g", "alt-F", "ctrl-f", "ctrl-l"):
			view = {
				"ctrl-g": "global",
				"alt-F": "global favorites",
				"ctrl-f": "favorites",
				"ctrl-l": "local",
				}[key]

			notice = "\nGLOBAL includes downloaded approved commands." if view == "global" else ""
			position = 1
			continue

		# Muut toiminnot edellyttävät valittua komentoa.
		if not selected_rows:
			notice = "\nNo command selected."
			continue

		row = selected_rows[0]
		try:
			index = int(row.split("\t", 1)[0])
			if not 0 <= index < len(displayed_entries):
				raise ValueError
		except ValueError:
			raise ValueError("Invalid picker selection.") from None
		try:
			position = max(1, int(position_path.read_text(encoding='utf-8')))
		except (OSError, ValueError):
			position = index + 1
		if key == "ctrl-p":
			try:
				promoted = toggle_priority_favorite(displayed_entries[index].command)
				displayed_entries[index].favorite = True
				entries[:] = entries_from_current(entries)
				global_entries = None
				notice = "\n◆ Priority favorite enabled." if promoted else "\n★ Priority removed; ordinary favorite retained."
			except (OSError, ValueError) as error:
				notice = "\nPriority save failed: " + display(str(error))
			continue
		if key in ("alt-up", "alt-down"):
			if reorder_priority(displayed_entries[index].command, -1 if key == "alt-up" else 1):
				entries[:] = entries_from_current(entries)
				global_entries = None
				notice = "\nPriority order updated."
			continue
		if key == "ctrl-d" and view in ("global", "global favorites"):
			notice = "\nDeletion disabled in GLOBAL; switch to LOCAL (Ctrl-L)."
			continue
		if key == "ctrl-d":
			# With --multi fzf prints marked rows; without marks it returns
			# the current row. Every index refers to the displayed order.
			indices = _cv_selection_indices(selected_rows, displayed_entries)
			if not indices:
				notice = "\nNo commands selected."
				continue
			if not _cv_confirm_batch_delete(len(indices)):
				notice = "\nDeletion cancelled."
				continue
			target = history_path or Path(os.environ.get("HISTFILE") or Path.home() / ".bash_history")
			deleted_indices = []
			occurrences = 0
			try:
				for selected_index in indices:
					occurrences += delete_entry(target, displayed_entries[selected_index].command)
					deleted_indices.append(selected_index)
			except (OSError, ValueError) as error:
				notice = "\nDeletion failed or was partial: " + display(str(error))
			else:
				notice = f"\nDeleted {len(deleted_indices)} command(s), {occurrences} history occurrence(s)."
			for selected_index in deleted_indices:
				entries.remove(displayed_entries[selected_index])
			if not entries:
				print("cmdvault: Selected commands deleted; no entries remain.", file=sys.stderr)
				return None
			position = 1
			continue
		if key not in ("ctrl-s", "alt-f"):
			return key, displayed_entries[index].command
		try:
			added = toggle_favorite(displayed_entries[index].command)
		except (OSError, ValueError) as error:
			notice = "\nFavorite update failed: " + display(str(error))
		else:
			displayed_entries[index].favorite = added
			entries[:] = entries_from_current(entries)
			global_entries = None
			notice = "\n★ Favorite enabled." if added else "\nFavorite removed (and priority cleared)."
