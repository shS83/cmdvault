#!/usr/bin/env python3
"""Find and keep useful commands from your own Bash history."""

import argparse
from dataclasses import dataclass
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile

VERSION = "0.1.3"


@dataclass
class Entry:
    command: str
    count: int = 0
    recent: int = -1
    favorite: bool = False


def history_commands(text):
    """Timestamped Bash entries preserve literal multiline commands."""
    pending = None
    for line in text.splitlines():
        if re.fullmatch(r"#[0-9]+", line):
            if pending is not None:
                command = "\n".join(pending)
                if command.strip():
                    yield command
            pending = []
        elif pending is not None:
            pending.append(line)
        elif line.strip():
            yield line
    if pending is not None:
        command = "\n".join(pending)
        if command.strip():
            yield command


def favorites_path():
    root = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share")
    return root / "cmdvault/favorites.json"


def read_favorites(path):
    if not path.exists():
        return []
    data = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(data, list) or any(
        not isinstance(command, str) or not command.strip() or "\0" in command
        for command in data
    ):
        raise ValueError(f"Invalid favorites file: {path}")
    return list(dict.fromkeys(data))


def update_favorite(path, command, remove=False):
    if not command.strip() or "\0" in command:
        raise ValueError("A command must be nonempty and contain no NUL characters.")
    # Lock a separate file because the JSON file is atomically replaced.
    import fcntl

    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    lock_fd = os.open(str(path) + ".lock", os.O_CREAT | os.O_RDWR, 0o600)
    with os.fdopen(lock_fd, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        commands = read_favorites(path)
        if remove:
            commands = [item for item in commands if item != command]
        elif command not in commands:
            commands.append(command)
        fd, temporary = tempfile.mkstemp(prefix=".favorites-", dir=path.parent)
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as output:
                json.dump(commands, output, ensure_ascii=False, indent=2)
                output.write("\n")
            os.replace(temporary, path)
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)


def history_without(text, command):
    """Remove exact logical entries, preserving untouched bytes and timestamps."""
    blocks = []
    pending = None
    for line in text.splitlines(keepends=True):
        if re.fullmatch(r"#[0-9]+", line.rstrip("\r\n")):
            if pending is not None:
                blocks.append(pending)
            pending = [line]
        elif pending is not None:
            pending.append(line)
        else:
            blocks.append([line])
    if pending is not None:
        blocks.append(pending)
    kept = []
    removed = 0
    for block in blocks:
        body = block[1:] if re.fullmatch(r"#[0-9]+", block[0].rstrip("\r\n")) else block
        value = "\n".join(line.rstrip("\r\n") for line in body)
        if value == command:
            removed += 1
        else:
            kept.extend(block)
    return "".join(kept), removed


def delete_history_command(path, command):
    """Delete all exact matches without creating a backup containing the secret."""
    import fcntl
    path = path.expanduser().resolve()
    if not path.exists():
        return 0
    with open(str(path) + ".cmdvault.lock", "a", encoding="utf-8") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        original = path.read_bytes()
        cleaned, removed = history_without(original.decode("utf-8"), command)
        if not removed:
            return 0
        fd, temporary = tempfile.mkstemp(prefix=".cmdvault-history-", dir=path.parent)
        try:
            with os.fdopen(fd, "wb") as output:
                output.write(cleaned.encode("utf-8"))
                output.flush()
                os.fsync(output.fileno())
            if path.read_bytes() != original:
                raise ValueError("History changed during deletion; retry.")
            os.replace(temporary, path)
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)
    return removed


def delete_entry(path, command):
    # Preflight favorites so malformed data is never silently discarded.
    favorite_file = favorites_path()
    favorites = read_favorites(favorite_file)
    count = delete_history_command(path, command)
    if command in favorites:
        update_favorite(favorite_file, command, remove=True)
    return count


def entries_from(history, favorites):
    entries = {}
    for index, command in enumerate(history_commands(history)):
        if "\0" in command:
            continue
        entry = entries.setdefault(command, Entry(command))
        entry.count += 1
        entry.recent = index
    for command in favorites:
        entries.setdefault(command, Entry(command)).favorite = True
    return sorted(entries.values(), key=lambda entry: (entry.favorite, entry.recent), reverse=True)


def display(command):
    # Escape control characters in the picker without changing the saved command.
    return json.dumps(command, ensure_ascii=False)[1:-1]


def pick(entries, query, favorites_only, enter_action="run", history_path=None):
    fzf = shutil.which("fzf")
    if not fzf:
        raise ValueError("fzf is required for the picker. Install it or use --list.")
    env = os.environ.copy()
    env.pop("FZF_DEFAULT_OPTS", None)
    env.pop("FZF_DEFAULT_OPTS_FILE", None)
    position = 1
    notice = ""
    while True:
        rows = "".join(
            f"{index}\t" + ("\x1b[33m" if entry.favorite else "") +
            f"{'★' if entry.favorite else '·'}  {entry.count:>4}x  {display(entry.command)}" +
            ("\x1b[0m" if entry.favorite else "") + "\n"
            for index, entry in enumerate(entries)
        )
        result = subprocess.run(
            [fzf, "--ansi", "--delimiter=\t", "--with-nth=2..", "--no-multi", "--layout=reverse",
             "--height=90%", "--border=rounded", "--prompt=vault › ", "--print-query",
             "--border-label= CMDVAULT / " + ("FAVORITES " if favorites_only else "HISTORY "),
             "--header=ENTER " + enter_action + " · CTRL-S / ALT-F save favorite (stay open) · CTRL-D delete permanently · CTRL-Y copy · ESC cancel" + notice,
             "--bind=start:pos(" + str(position) + ")",
             "--expect=ctrl-s,alt-f,ctrl-y,ctrl-d", "--query=" + query],
            input=rows, capture_output=True, text=True, env=env,
        )
        if result.returncode in (1, 130):
            return None
        if result.returncode:
            raise ValueError("fzf failed: " + result.stderr.strip())
        lines = result.stdout.splitlines()
        if len(lines) != 3 or lines[1] not in ("", "ctrl-s", "alt-f", "ctrl-y", "ctrl-d"):
            raise ValueError("Invalid picker output.")
        query, key, row = lines
        try:
            index = int(row.split("\t", 1)[0])
            if not 0 <= index < len(entries):
                raise ValueError
        except ValueError:
            raise ValueError("Invalid picker selection.") from None
        if key == "ctrl-d":
            try:
                target = history_path or Path(os.environ.get("HISTFILE") or Path.home() / ".bash_history")
                count = delete_entry(target, entries[index].command)
            except (OSError, ValueError):
                notice = "\nDeletion failed or was partial. Reload history and check file permissions; the command was not printed."
            else:
                entries.pop(index)
                query = ""  # A search query can itself contain the deleted secret.
                notice = f"\nDeleted {count} history occurrence(s) and removed the favorite."
                if not entries:
                    print("cmdvault: Selected command deleted; no entries remain.", file=sys.stderr)
                    return None
            continue
        if key not in ("ctrl-s", "alt-f"):
            return key, entries[index].command
        try:
            update_favorite(favorites_path(), entries[index].command)
        except (OSError, ValueError) as error:
            notice = "\nSave failed: " + display(str(error))
        else:
            entries[index].favorite = True
            notice = "\n★ Favorite saved. Yellow rows are saved favorites."
        # Keep the selected command near the top without changing its original text.
        entry = entries.pop(index)
        entries.insert(0, entry)
        position = 1


def copy_command(command, functions_file=None, terminal="/dev/tty"):
    functions_file = functions_file or Path.home() / ".functions"
    if not Path(functions_file).is_file():
        raise ValueError(f"Copy function file not found: {functions_file}")
    try:
        with open(terminal, "w", encoding="utf-8") as output:
            result = subprocess.run(
                ["bash", "--noprofile", "--norc", "-c",
                 'source "$1" || exit; declare -F copy >/dev/null || exit 127; copy',
                 "cmdvault-copy", str(functions_file)],
                input=command, text=True, stdout=output, stderr=subprocess.PIPE,
            )
    except OSError as error:
        raise ValueError(f"Cannot access the terminal for copy(): {error}") from error
    if result.returncode:
        raise ValueError("copy() failed: " + (result.stderr.strip() or "check ~/.functions"))


def execute_command(command):
    """Replace cmdvault with Bash, retaining the terminal, cwd and environment."""
    bash = shutil.which("bash")
    if not bash:
        raise ValueError("Bash is required to execute commands.")
    # Interactive startup loads the user's aliases/functions from ~/.bashrc.
    # The original command is one argv element, never reconstructed from display text.
    os.execv(bash, [bash, "--noprofile", "-ic", command])


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("query", nargs="*", help="initial fzf search; substring filter with --list")
    parser.add_argument("--version", action="version", version=f"cmdvault {VERSION}")
    parser.add_argument("--history", type=Path,
                        default=Path(os.environ.get("HISTFILE") or Path.home() / ".bash_history"),
                        help="Bash history file (default: HISTFILE or ~/.bash_history)")
    parser.add_argument("--favorites", action="store_true", help="show only saved commands")
    actions = parser.add_mutually_exclusive_group()
    actions.add_argument("--list", action="store_true", help="print commands without fzf")
    actions.add_argument("--print", dest="print_only", action="store_true", help="print the selection instead of running it")
    actions.add_argument("--copy", action="store_true", help="copy the selected command")
    actions.add_argument("--add", metavar="COMMAND", help="save an exact command as a favorite")
    actions.add_argument("--remove", metavar="COMMAND", help="remove an exact favorite")
    args = parser.parse_args(argv)
    if (args.add is not None or args.remove is not None) and args.query:
        parser.error("--add and --remove take one quoted command, without search terms")
    path = favorites_path()
    if args.add is not None or args.remove is not None:
        update_favorite(path, args.add if args.add is not None else args.remove,
                        remove=args.remove is not None)
        print("cmdvault: Favorite " + ("removed." if args.remove is not None else "saved."), file=sys.stderr)
        return 0
    favorites = read_favorites(path)
    history = ""
    if not args.favorites:
        try:
            history = args.history.read_text(encoding="utf-8")
        except FileNotFoundError:
            print(f"cmdvault: History file not found: {args.history}", file=sys.stderr)
    entries = entries_from(history, favorites)
    query = " ".join(args.query)
    if args.list:
        for entry in entries:
            if query.casefold() in entry.command.casefold():
                print(entry.command)
        return 0
    if not entries:
        print(f"cmdvault: No commands found. Favorites file: {path}. Save with Ctrl-S / Alt-F or --add; Ctrl-Y only copies.", file=sys.stderr)
        return 1
    selected = pick(entries, query, args.favorites, "copy" if args.copy else "print" if args.print_only else "run", args.history)
    if selected is None:
        return 1
    key, command = selected
    if key == "ctrl-y" or args.copy:
        try:
            copy_command(command)
        except ValueError:
            print(command)
            raise
        print("cmdvault: Sent to copy().", file=sys.stderr)
    elif args.print_only:
        print(command)
    else:
        execute_command(command)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError) as error:
        print(f"cmdvault: {error}", file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
