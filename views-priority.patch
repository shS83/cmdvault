+def priority_path():
+    return favorites_path().with_name("favorites.priority.json")
+
+
+def read_priorities():
+    path = priority_path()
+    try:
+        data = json.loads(path.read_text(encoding="utf-8"))
+    except FileNotFoundError:
+        return []
+    if not isinstance(data, list) or any(not isinstance(x, str) for x in data):
+        raise ValueError("Invalid priority favorites file")
+    return list(dict.fromkeys(data))
+
+
+def write_priorities(items):
+    # Atomic replacement; keep a separate ordering file, preserving favorites.json.
+    path = priority_path()
+    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
+    fd, temporary = tempfile.mkstemp(prefix=".priority-", dir=path.parent)
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8") as output:
+            json.dump(items, output, ensure_ascii=False, indent=2)
+            output.write("\n")
+            output.flush()
+            os.fsync(output.fileno())
+        os.chmod(temporary, 0o600)
+        os.replace(temporary, path)
+    finally:
+        if os.path.exists(temporary):
+            os.unlink(temporary)
+
+
+def prioritize_favorite(command):
+    update_favorite(favorites_path(), command)
+    priorities = read_priorities()
+    write_priorities([command, *(x for x in priorities if x != command)])
+
+
+def reorder_priority(command, direction):
+    priorities = read_priorities()
+    if command not in priorities:
+        return False
+    i = priorities.index(command)
+    j = i + direction
+    if not 0 <= j < len(priorities):
+        return False
+    priorities[i], priorities[j] = priorities[j], priorities[i]
+    write_priorities(priorities)
+    return True
+
