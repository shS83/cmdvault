# Place real configuration outside the checkout, mode 0600. Never commit it.
DJANGO_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_50_CHARACTERS
DJANGO_ALLOWED_HOSTS=sync.prometheus-alexander.fi,127.0.0.1,localhost
PGDATABASE=cmdvault
PGUSER=cmdvault
PGPASSWORD=REPLACE_WITH_A_RANDOM_DATABASE_PASSWORD
PGHOST=127.0.0.1
PGPORT=5432
DEVICE_TOKEN_DAYS=90
LOGIN_LIMIT=10
# Enable only behind the provided trusted localhost nginx proxy.
TRUST_PROXY=true
SECURE_SSL_REDIRECT=true
# Keep false for real history until client encryption/recovery/filtering is ready.
SYNC_ENABLED=false
